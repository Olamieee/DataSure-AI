# DataSure AI environment configuration template.
# Copy to `.env` and adjust. Never commit the real .env file.

# Required in production: generate with
#   python -c "import secrets; print(secrets.token_hex(32))"
DATASURE_SECRET_KEY=

# Environment: development | production (default) | testing
DATASURE_CONFIG=development

# Database: defaults to ./instance/datasure.db (SQLite).
# For PostgreSQL set something like:
# DATASURE_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/datasure

# Upload and profiling limits
DATASURE_MAX_UPLOAD_MB=50
DATASURE_MAX_ROWS=500000
DATASURE_MAX_COLUMNS=400
